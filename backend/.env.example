# Backend configuration. Copy this file to backend/.env and fill only what is needed.
DATAFIX_STORAGE_BACKEND=local
DATAFIX_STORAGE_DIR=./datafix_storage
DATAFIX_MAX_UPLOAD_BYTES=5242880
DATAFIX_MAX_ROWS=50000
DATAFIX_MAX_COLUMNS=60
DATAFIX_MAX_CELL_CHARS=100000
DATAFIX_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional Supabase backend adapter. Requires the backend-only service-role key.
# The publishable/anon key is not suitable for backend administrative storage.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-server-only-secret-key
# Legacy alternative if the project does not yet use new secret keys:
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=datafix

# Optional Groq explanations. Disabled by default; no request is made when false.
LLM_ENABLED=false
GROQ_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b
LLM_TIMEOUT_SECONDS=8
LLM_MAX_RETRIES=1
LLM_REQUESTS_PER_RUN=20

MINIMUM_BACKTEST_SAMPLES=20
DATAFIX_AGGREGATE_DRIFT_FORMAT_MAX_PCT=5.0
DATAFIX_AGGREGATE_DRIFT_SUBSTITUTION_MAX_PCT=5.0
DATAFIX_AGGREGATE_DRIFT_IMPUTATION_MAX_PCT=1.0
DATAFIX_AGGREGATE_DRIFT_DESTRUCTIVE_MAX_PCT=10.0
